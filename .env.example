# Copy to .env for local development. In production set these in
# Vercel → Project → Settings → Environment Variables. Never commit .env.

# Resend API key (https://resend.com/api-keys) — server-side only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where submissions are delivered.
CONTACT_TO_EMAIL=info@billwisellc.com

# Sender address. Must be on a domain verified in Resend (billwisellc.com).
CONTACT_FROM_EMAIL="Bill Wise Website <forms@billwisellc.com>"
